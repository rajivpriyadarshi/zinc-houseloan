{
  "public": "dist",
  "rewrites": [
    { "source": "/planner", "destination": "/planner.html" },
    { "source": "/location", "destination": "/location.html" },
    { "source": "/breakdown", "destination": "/breakdown.html" },
    { "source": "/results", "destination": "/results.html" },
    { "source": "/transition", "destination": "/transition.html" },
    { "source": "/ping", "destination": "/ping.html" }
  ],
  "headers": [
    {
      "source": "**/*.@(jpg|jpeg|gif|png|svg|webp|js|css|woff|woff2|ttf|eot|otf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "**/*.@(html)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, no-store, must-revalidate"
        }
      ]
    }
  ]
}
